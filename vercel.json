{
  "version": 2,
  "builds": [
    {
      "src": "billing-backend/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "billing-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/billing-backend/api/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/billing-frontend/dist/assets/$1"
    },
    {
      "src": "^/(.*\\.(svg|ico|png|jpg|jpeg|json|webmanifest))$",
      "dest": "/billing-frontend/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/billing-frontend/dist/index.html"
    }
  ]
}
